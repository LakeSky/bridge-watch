# ===== bridge-watch 配置模板 =====
# 复制为 .env 并填入真实值。

# ---- 链与 RPC ----
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# ---- 监控资产（ERC20，默认 Base USDC）----
ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ASSET_DECIMALS=6
ASSET_SYMBOL=USDC

# ---- 监控对象：桥合约 / 协议金库 / 巨鲸地址（逗号分隔）----
# 如何找：区块浏览器里查某桥的合约地址，或 Etherscan 标签里"Bridge"类合约。
WATCH_ADDRESSES=

# ---- 告警阈值 ----
# 单笔转出超过该 USDC 金额即告警（人类单位，默认 10 万 USDC）
LARGE_OUTFLOW_USDC=100000
# 窗口内余额下降超过该百分比即判定"疑似抽干"（默认 25%）
DRAIN_PERCENT=25
# 抽干检测窗口（秒，默认 10 分钟）
DRAIN_WINDOW_SECONDS=600
# 轮询间隔（秒，默认 30）
POLL_INTERVAL_SECONDS=30

# ---- Telegram 告警（可选，不填则只打印到控制台/日志）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- API 服务（Week 5，付费查询 API）----
# 逗号分隔的有效 API key；不填则 API 服务拒绝启动
API_KEYS=
API_PORT=4022
API_CREDITS=1000
