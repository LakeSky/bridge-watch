{
  "name": "bridge-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-chain bridge & on-chain risk monitor (Week 1 MVP) — watches bridge/treasury contracts for fund drains and large outflows, alerts via Telegram.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "label": "tsx src/cli.ts label",
    "cluster": "tsx src/cli.ts cluster",
    "alerts": "tsx src/cli.ts alerts",
    "alerts:stats": "tsx src/cli.ts alerts:stats",
    "import": "tsx src/import.ts",
    "explain": "tsx src/explain.ts",
    "api": "tsx src/api/index.ts",
    "track": "tsx src/track.ts",
    "payments": "tsx src/payments.ts",
    "credit:daemon": "tsx src/payment/credit-daemon.ts",
    "credit:once": "tsx src/payment/credit-daemon.ts --once",
    "mcp": "tsx src/mcp/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "viem": "^2.56.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
